# ==========================================
# Kiro2Api 环境变量配置示例
# ==========================================
# 复制此文件为 .env 并根据实际情况修改配置

# 控制台访问密码
UI_PASSWORD=asdfasdf

# ------------------------------------------
# 运行环境配置
# ------------------------------------------

# Node 运行环境: development | production | test
NODE_ENV=production

# 日志级别: verbose | debug | info | warn | error
LOG_LEVEL=info

# 是否为 Worker 进程（由 master.js 自动设置，无需手动配置）
# IS_WORKER_PROCESS=false

# ------------------------------------------
# 服务器配置
# ------------------------------------------

# Master 进程管理端口（用于进程管理和监控）
MASTER_PORT=3100

# CORS 允许的来源（逗号分隔的 URL 列表）
CORS_ALLOWED_ORIGINS=

# 允许在生产环境使用弱 API Key（不推荐）
ALLOW_WEAK_API_KEY=false

# ------------------------------------------
# Redis 缓存配置
# ------------------------------------------

REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------
# Token 加密 / 账号池配置
# ------------------------------------------

# Token 加密密钥（用于加密存储的 OAuth Token）
# 生成命令: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# 账号池模式: legacy | account
ACCOUNT_POOL_MODE=legacy

# ------------------------------------------
# Web 搜索配置
# ------------------------------------------

WEB_SEARCH_ENGINE=duckduckgo
BING_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# ------------------------------------------
# 超时配置
# ------------------------------------------

KIRO_REQUEST_TIMEOUT_MS=120000
KIRO_STREAM_TIMEOUT_MS=180000

# ------------------------------------------
# 日志配置
# ------------------------------------------

# 是否记录未定义路由的请求详情到文件
LOG_UNMATCHED_ROUTES=false
