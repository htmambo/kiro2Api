# ==========================================
# Kiro2Api 环境变量配置示例
# ==========================================
# 复制此文件为 .env 并根据实际情况修改配置

# ------------------------------------------
# 运行环境配置
# ------------------------------------------

# Node 运行环境: development | production | test
# - development: 开发模式，启用详细日志和热重载
# - production: 生产模式，优化性能和安全性
# - test: 测试模式
NODE_ENV=production

# 日志级别: verbose | debug | info | warn | error
# - verbose: 最��细的日志（包含所有调试信息）
# - debug: 调试日志（开发时使用）
# - info: 一般信息日志（默认）
# - warn: 警告日志（仅显示警告和错误）
# - error: 错误日志（仅显示错误）
# 默认: info
LOG_LEVEL=info

# 是否为 Worker 进程（由 master.js 自动设置，无需手动配置）
# IS_WORKER_PROCESS=false

# ------------------------------------------
# 服务器配置
# ------------------------------------------

# Master 进程管理端口（用于进程管理和监控）
# 默认: 3100
MASTER_PORT=3100

# ------------------------------------------
# 账号池配置
# ------------------------------------------

# 账号池模式: legacy | account
# - legacy: 兼容模式（等同于 account）
# - account: 使用 accounts/account_pool.json 管理账号
# 默认: legacy
ACCOUNT_POOL_MODE=legacy

# ------------------------------------------
# Web 搜索配置
# ------------------------------------------

# 搜索引擎: duckduckgo | bing
# - duckduckgo: 使用 DuckDuckGo（无需 API Key）
# - bing: 使用 Bing Search API（需要 API Key）
# 默认: duckduckgo
WEB_SEARCH_ENGINE=duckduckgo

# Bing Search API Key（仅当 WEB_SEARCH_ENGINE=bing 时需要）
# 获取方式: https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
BING_API_KEY=

# 搜索结果最大数量（1-20）
# 默认: 5
WEB_SEARCH_MAX_RESULTS=5

# ------------------------------------------
# 超时配置
# ------------------------------------------

# API 请求超时时间（毫秒，1000-600000）
# 默认: 120000 (120秒)
KIRO_REQUEST_TIMEOUT_MS=120000

# 流式请求超时时间（毫秒，1000-600000）
# 默认: 180000 (180秒)
KIRO_STREAM_TIMEOUT_MS=180000

# ------------------------------------------
# 高级配置
# ------------------------------------------

# 自定义 .env 文件路径（可选）
# 默认: 当前工作目录下的 .env 文件
# KIRO_DOTENV_PATH=/path/to/custom/.env
