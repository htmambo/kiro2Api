# ==========================================
# Kiro2Api 环境变量配置示例
# ==========================================
# 复制此文件为 .env 并根据实际情况修改配置

# 控制台访问密码
# 建议使用至少 16 位强密码，或写入 scrypt$<salt>$<hash> 格式
UI_PASSWORD=replace-with-a-strong-password

# ------------------------------------------
# 运行环境配置
# ------------------------------------------

# Node 运行环境: development | production | test
# - development: 开发模式，启用详细日志和热重载
# - production: 生产模式，优化性能和安全性
# - test: 测试模式
NODE_ENV=production

# 日志级别: verbose | debug | info | warn | error
# - verbose: 最��细的日志（包含所有调试信息）
# - debug: 调试日志（开发时使用）
# - info: 一般信息日志（默认）
# - warn: 警告日志（仅显示警告和错误）
# - error: 错误日志（仅显示错误）
# 默认: info
LOG_LEVEL=info

# 是否为 Worker 进程（由 master.js 自动设置，无需手动配置）
# IS_WORKER_PROCESS=false

# ------------------------------------------
# 服务器配置
# ------------------------------------------

# Master 进程管理端口（用于进程管理和监控）
# 默认: 3100
MASTER_PORT=3100

# API 服务监听端口
SERVER_PORT=8045

# API 服务监听地址
HOST=0.0.0.0

# API 访问密钥（必须修改）
REQUIRED_API_KEY=replace-with-a-strong-api-key

# 是否在启动后自动打开浏览器
# 仅建议在本机开发时开启
OPEN_SERVER_URL=false

# 允许跨域访问的来源，多个值用逗号分隔
# 例如: http://localhost:5173,https://your-console.example.com
CORS_ALLOWED_ORIGINS=

# ------------------------------------------
# 账号池配置
# ------------------------------------------

# 账号池配置文件
ACCOUNT_POOL_FILE_PATH=./configs/account_pool.json

# ------------------------------------------
# 超时配置
# ------------------------------------------

# API 请求超时时间（毫秒，1000-600000）
# 默认: 120000 (120秒)
KIRO_REQUEST_TIMEOUT_MS=120000

# 流式请求超时时间（毫秒，1000-600000）
# 默认: 180000 (180秒)
KIRO_STREAM_TIMEOUT_MS=180000

# ------------------------------------------
# 高级配置
# ------------------------------------------

# 系统提示词模式: overwrite | append
SYSTEM_PROMPT_MODE=overwrite

# 日志记录模式: none | console | file
PROMPT_LOG_MODE=none

# 是否启用 SQLite 账号池
USE_SQLITE_POOL=false
