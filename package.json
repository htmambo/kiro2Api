{
  "name": "kiro2api",
  "version": "1.0.0",
  "description": "Kiro OAuth to API - Free Claude API Access",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "axios": "^1.13.6",
    "better-sqlite3": "^12.5.0",
    "deepmerge": "^4.3.1",
    "dotenv": "^16.4.5",
    "google-auth-library": "^10.1.0",
    "lodash": "^4.17.23",
    "multer": "^2.1.1",
    "open": "^10.2.0",
    "redis": "^4.7.0",
    "undici": "^7.22.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "http-proxy": "^1.18.1",
    "jest": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "nodemon": "^3.1.4"
  },
  "scripts": {
    "start": "NODE_ENV=production node --max-old-space-size=120 src/api/server.js",
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "VITE_DEV_SERVER_URL=http://localhost:5173 nodemon",
    "dev:web": "npm --prefix frontend-vue run dev",
    "deploy:frontend": "bash deploy-frontend.sh",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop kiro2api",
    "pm2:restart": "pm2 restart kiro2api",
    "pm2:delete": "pm2 delete kiro2api",
    "pm2:logs": "pm2 logs kiro2api",
    "pm2:status": "pm2 status",
    "pm2:monit": "pm2 monit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:verbose": "jest --verbose --runInBand",
    "test:silent": "jest --silent --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=tests/unit",
    "test:integration": "jest --runInBand --testPathPattern=tests/integration --passWithNoTests",
    "test:summary": "node test-summary.js"
  }
}
